# Copy this file to .env before running docker compose.

# --- Postgres ---
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops
POSTGRES_DB=aiopsforge

# --- Ollama ---
# Any Ollama model tag works. A coding-capable model is recommended since
# Phase 2's Developer Agent will use the same one. If your machine is low on
# RAM/VRAM, swap for a smaller tag, e.g. qwen2.5-coder:1.5b.
OLLAMA_MODEL=qwen2.5-coder:7b
# Extra models to pull at start-up (space separated). The experiments compare 3B vs 7B.
OLLAMA_EXTRA_MODELS=qwen2.5-coder:3b
# Memory the Ollama container may use. A 7B model needs well over 4 GB (weights + context):
# keep this at 8g or more, and make sure your machine really has that much free RAM
# (a 7B model on a laptop with <= 8 GB total RAM will swap and be extremely slow).
OLLAMA_MEM_LIMIT=10g

# --- MCP server ---
MCP_SERVER_URL=http://mcp-server:9000/mcp

# --- Long-term memory (Week 7) ---
# Any Ollama embedding model works; must match the vector(768) dimension in
# db/init.sql if you change it. nomic-embed-text is a good free default.
EMBEDDING_MODEL=nomic-embed-text

# --- Langfuse tracing (Week 10) — OPTIONAL ---
# Leave these blank to run with tracing disabled (the pipeline works fine
# either way — llm.py degrades to a no-op if no public key is set). To
# enable tracing, sign up for a free Langfuse Cloud project at
# https://cloud.langfuse.com and paste your keys below, OR self-host
# Langfuse separately (it needs its own Postgres/ClickHouse/Redis/MinIO —
# see https://langfuse.com/self-hosting — deliberately NOT bundled into
# this project's docker-compose.yml to keep this stack's footprint small).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Dashboard (Week 9) ---
# The URL the React dashboard (running in your browser) uses to reach the
# backend. localhost:8000 is correct for the default docker-compose setup.
DASHBOARD_BACKEND_URL=http://localhost:8000

# --- Backend ---
# These three are overridden by docker-compose.yml when running inside Docker
# (service names replace localhost). They're only used if you run the backend
# directly on your host machine instead of in a container.
DATABASE_URL=postgresql://aiops:aiops@localhost:5432/aiopsforge
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434

# --- Metrics & observability (all optional) ---
# METRICS_ENABLED=true
# USD per 1K tokens. Local Ollama has no API bill, so these default to a
# cloud-equivalent reference price that makes runs/models comparable.
# Set both to 0 to track tokens and latency only.
# TOKEN_RATE_IN_PER_1K=0.0005
# TOKEN_RATE_OUT_PER_1K=0.0015

# --- User intervention (pause / feedback / resume) ---
# A pause nobody answers auto-approves after this many seconds (0 = wait forever).
# INTERVENTION_TIMEOUT_SECONDS=900
# How many times one pause point may loop ("re-plan", "regenerate") before the run proceeds.
# INTERVENTION_MAX_REVISIONS=5

# --- Batches & experiments ---
# Pipelines run at once within one batch (Ollama may still serialise generation; see README).
# BATCH_MAX_CONCURRENCY=5
# Hard cap on the runs one batch / experiment may create.
# BATCH_MAX_RUNS=100


# --- Reproducibility (Phase 18) ---
# Leave unset to use Ollama's own defaults (random sampling, small context window).
# For the paper experiments set a seed and a low temperature, and write the values down:
# the same settings can also be given per run / per experiment arm through the API.
# OLLAMA_TEMPERATURE=0
# OLLAMA_SEED=42
# Prompts that include the original request AND a failure diagnosis are long; Ollama
# silently truncates what does not fit in the context window, so set this explicitly.
# OLLAMA_NUM_CTX=8192
