# Copy this file to .env before running docker compose.

# --- Postgres ---
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops
POSTGRES_DB=aiopsforge

# --- Ollama ---
# Any Ollama model tag works. A coding-capable model is recommended since
# Phase 2's Developer Agent will use the same one. If your machine is low on
# RAM/VRAM, swap for a smaller tag, e.g. qwen2.5-coder:1.5b.
OLLAMA_MODEL=qwen2.5-coder:7b

# --- MCP server ---
MCP_SERVER_URL=http://mcp-server:9000/mcp

# --- Long-term memory (Week 7) ---
# Any Ollama embedding model works; must match the vector(768) dimension in
# db/init.sql if you change it. nomic-embed-text is a good free default.
EMBEDDING_MODEL=nomic-embed-text

# --- Langfuse tracing (Week 10) — OPTIONAL ---
# Leave these blank to run with tracing disabled (the pipeline works fine
# either way — llm.py degrades to a no-op if no public key is set). To
# enable tracing, sign up for a free Langfuse Cloud project at
# https://cloud.langfuse.com and paste your keys below, OR self-host
# Langfuse separately (it needs its own Postgres/ClickHouse/Redis/MinIO —
# see https://langfuse.com/self-hosting — deliberately NOT bundled into
# this project's docker-compose.yml to keep this stack's footprint small).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Dashboard (Week 9) ---
# The URL the React dashboard (running in your browser) uses to reach the
# backend. localhost:8000 is correct for the default docker-compose setup.
DASHBOARD_BACKEND_URL=http://localhost:8000

# --- Backend ---
# These three are overridden by docker-compose.yml when running inside Docker
# (service names replace localhost). They're only used if you run the backend
# directly on your host machine instead of in a container.
DATABASE_URL=postgresql://aiops:aiops@localhost:5432/aiopsforge
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434
